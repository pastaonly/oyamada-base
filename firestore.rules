rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isLogOwner(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    function isThanksIncrement() {
      return isAuthenticated() &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(["thanksCount", "updatedAt"]) &&
        request.resource.data.thanksCount == resource.data.thanksCount + 1 &&
        request.resource.data.commentCount == resource.data.commentCount;
    }

    function isCommentCountUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let previous = resource.data.commentCount == null ? 0 : resource.data.commentCount;
      let next = request.resource.data.commentCount;
      return isAuthenticated() &&
        diff.changedKeys().hasOnly(["commentCount", "updatedAt"]) &&
        request.resource.data.thanksCount == resource.data.thanksCount &&
        next != null &&
        next >= 0 &&
        (next == previous + 1 || (previous > 0 && next == previous - 1));
    }

    match /memberContracts/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /reservations/{reservationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /activityDefinitions/{definitionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || isLogOwner(resource.data);
      allow update: if isAdmin() || isLogOwner(resource.data) || isThanksIncrement() || isCommentCountUpdate();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.logId == logId;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
